# ═══════════════════════════════════════════════════════════════════════════════
# Foretyx Data Plane — Environment Configuration Template
# ═══════════════════════════════════════════════════════════════════════
# Copy this to .env and fill in your values:   cp .env.example .env

# ── Arbiter Security ───────────────────────────────────────────────────────────
ARBITER_SECRET_KEY=your-secret-key-for-jwt-signing-min-32-chars
ARBITER_MASTER_KEY=your-32-byte-url-safe-base64-fernet-key-here
DATABASE_URL=postgresql+asyncpg://foretyx:foretyx@postgres:5432/foretyx
DB_PASSWORD=your_secure_db_password_here

# ── PII Service ───────────────────────────────────────────────────────────────
PII_SERVICE_URL=http://pii-service:8001
PII_SERVICE_KEY=your-pii-service-api-key-here


# ── SECURITY: Admin API Key (REQUIRED) ───────────────────────────────────────
# This key is required to access /v1/logs and /v1/metrics endpoints
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=your_secure_admin_api_key_min_32_chars_long


# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FORMAT=json

# ── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080

